{
  "_meta": {
    "name": "Z-Image Base bf16 (CFG text-to-image, feathered hand inpaint, safe-edge crop)",
    "notes": "Official Base guidance settings: 50-step CFG 4 render with a real negative conditioning branch, followed by 28-step CFG 4 hand detail inpaint and deterministic center crop."
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "z_image_bf16.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_4b.safetensors",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "${PROMPT}"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "${NEGATIVE}"
    }
  },
  "7": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": "${GEN_WIDTH}",
      "height": "${GEN_HEIGHT}",
      "batch_size": 1
    }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0],
      "seed": "${SEED}",
      "steps": 50,
      "cfg": 4.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["8", 0],
      "vae": ["3", 0]
    }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["16", 0],
      "filename_prefix": "${PREFIX}"
    }
  },
  "11": {
    "class_type": "UltralyticsDetectorProvider",
    "inputs": {
      "model_name": "bbox/hand_yolov8s.pt"
    }
  },
  "12": {
    "class_type": "BboxDetectorSEGS",
    "inputs": {
      "bbox_detector": ["11", 0],
      "image": ["9", 0],
      "threshold": 0.35,
      "dilation": 24,
      "crop_factor": 2.5,
      "drop_size": 16,
      "labels": "all"
    }
  },
  "13": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "${HAND_REFINE_PROMPT}"
    }
  },
  "14": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "${HAND_REFINE_NEGATIVE}"
    }
  },
  "15": {
    "class_type": "DetailerForEach",
    "inputs": {
      "image": ["9", 0],
      "segs": ["12", 0],
      "model": ["1", 0],
      "clip": ["2", 0],
      "vae": ["3", 0],
      "guide_size": 512,
      "guide_size_for": true,
      "max_size": 768,
      "seed": "${HAND_SEED}",
      "steps": 28,
      "cfg": 4.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["13", 0],
      "negative": ["14", 0],
      "denoise": 0.22,
      "feather": 48,
      "noise_mask": true,
      "force_inpaint": true,
      "wildcard": "",
      "cycle": 1,
      "inpaint_model": false,
      "noise_mask_feather": 48
    }
  },
  "16": {
    "class_type": "ImageCrop",
    "inputs": {
      "image": ["15", 0],
      "width": "${WIDTH}",
      "height": "${HEIGHT}",
      "x": "${EDGE_CROP_X}",
      "y": "${EDGE_CROP_Y}"
    }
  }
}
