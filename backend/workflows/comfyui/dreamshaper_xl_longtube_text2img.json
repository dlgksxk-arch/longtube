{
  "_meta": {
    "name": "DreamShaper XL Lightning + LongTube Style LoRA",
    "notes": "DreamShaper XL + 커스텀 LongTube 스타일 LoRA. GPT Image 1 스타일을 학습시킨 LoRA. trigger word: longtube style. LoRA weight 0.85 권장. 8 steps, cfg 2.0, dpmpp_sde/karras."
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "dreamshaperXL_sfwLightningDPMSDE.safetensors"
    }
  },
  "8": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["1", 0],
      "clip": ["1", 1],
      "lora_name": "longtube_style_v1.safetensors",
      "strength_model": 0.85,
      "strength_clip": 0.75
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["8", 1],
      "text": "${PROMPT}"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["8", 1],
      "text": "${NEGATIVE}"
    }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "${WIDTH}",
      "height": "${HEIGHT}",
      "batch_size": 1
    }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["8", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0],
      "seed": "${SEED}",
      "steps": 20,
      "cfg": 3.0,
      "sampler_name": "dpmpp_sde",
      "scheduler": "karras",
      "denoise": 1.0
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["5", 0],
      "vae": ["1", 2]
    }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["6", 0],
      "filename_prefix": "${PREFIX}"
    }
  },
  "26": {
    "class_type": "UltralyticsDetectorProvider",
    "inputs": {
      "model_name": "segm/person_yolov8m-seg.pt"
    }
  },
  "32": {
    "class_type": "ImpactCount_Elts_in_SEGS",
    "inputs": {
      "segs": ["44", 0]
    }
  },
  "33": {
    "class_type": "Display Int (rgthree)",
    "inputs": {
      "input": ["32", 0]
    }
  },
  "34": {
    "class_type": "UltralyticsDetectorProvider",
    "inputs": {
      "model_name": "bbox/face_yolov8m.pt"
    }
  },
  "35": {
    "class_type": "BboxDetectorSEGS",
    "inputs": {
      "bbox_detector": ["34", 0],
      "image": ["6", 0],
      "threshold": 0.35,
      "dilation": 4,
      "crop_factor": 1.25,
      "drop_size": 20,
      "labels": "all"
    }
  },
  "36": {
    "class_type": "ImpactCount_Elts_in_SEGS",
    "inputs": {
      "segs": ["35", 0]
    }
  },
  "37": {
    "class_type": "Display Int (rgthree)",
    "inputs": {
      "input": ["36", 0]
    }
  },
  "38": {
    "class_type": "SegmDetectorSEGS",
    "inputs": {
      "segm_detector": ["26", 1],
      "image": ["6", 0],
      "threshold": 0.25,
      "dilation": 4,
      "crop_factor": 1.2,
      "drop_size": 32,
      "labels": "person"
    }
  },
  "39": {
    "class_type": "ImpactCount_Elts_in_SEGS",
    "inputs": {
      "segs": ["38", 0]
    }
  },
  "40": {
    "class_type": "Display Int (rgthree)",
    "inputs": {
      "input": ["39", 0]
    }
  },
  "44": {
    "class_type": "SegmDetectorSEGS",
    "inputs": {
      "segm_detector": ["26", 1],
      "image": ["6", 0],
      "threshold": 0.42,
      "dilation": 12,
      "crop_factor": 1.35,
      "drop_size": 64,
      "labels": "person"
    }
  },
  "45": {
    "class_type": "UltralyticsDetectorProvider",
    "inputs": {
      "model_name": "bbox/yolov8m.pt"
    }
  },
  "46": {
    "class_type": "BboxDetectorSEGS",
    "inputs": {
      "bbox_detector": ["45", 0],
      "image": ["6", 0],
      "threshold": 0.32,
      "dilation": 2,
      "crop_factor": 1.1,
      "drop_size": 32,
      "labels": "cow"
    }
  },
  "47": {
    "class_type": "ImpactCount_Elts_in_SEGS",
    "inputs": {
      "segs": ["46", 0]
    }
  },
  "48": {
    "class_type": "Display Int (rgthree)",
    "inputs": {
      "input": ["47", 0]
    }
  }
}
